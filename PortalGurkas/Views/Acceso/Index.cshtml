@model PortalGurkas.Models.Acceso.Usuario;
@{
    Layout = null;
}


<!DOCTYPE html>
<html class="h-full" data-kt-theme="true" data-kt-theme-mode="light" dir="ltr" lang="en">
<head>
    <base href="../../../../../">
    <title>
       Portal Gurkas
    </title>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport" />

    <link href="media/app/gurkas-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="media/app/gurkas_favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="media/app/gurkas_favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
    <link href="media/app/gurkas.ico" rel="shortcut icon" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="vendors/apexcharts/apexcharts.css" rel="stylesheet" />
    <link href="vendors/keenicons/styles.bundle.css" rel="stylesheet" />
    <link href="css/styles.css" rel="stylesheet" />
</head>
<body class="antialiased flex h-full text-base text-foreground bg-background">

    <!-- Theme Mode -->
    <script>
        const defaultThemeMode = 'light'; // light|dark|system
                 let themeMode;

                 if (document.documentElement) {
                     if (localStorage.getItem('kt-theme')) {
                         themeMode = localStorage.getItem('kt-theme');
                     } else if (
                         document.documentElement.hasAttribute('data-kt-theme-mode')
                     ) {
                         themeMode =
                             document.documentElement.getAttribute('data-kt-theme-mode');
                     } else {
                         themeMode = defaultThemeMode;
                     }

                     if (themeMode === 'system') {
                         themeMode = window.matchMedia('(prefers-color-scheme: dark)').matches
                             ? 'dark'
                             : 'light';
                     }

                     document.documentElement.classList.add(themeMode);
                 }
    </script>
    <!-- End of Theme Mode -->

    <!-- Page -->
    <style>
        .page-bg {
            background-image: url('media/images/2600x1200/bg-10.png');
        }

        .dark .page-bg {
            background-image: url('media/images/2600x1200/bg-10-dark.png');
        }

        .login-container {
            width: 100%;
            max-width: 500px;
        }

        .login-header {
            text-align: center;
            padding-bottom: 18px;
            border-bottom: 1px solid #d9dee6;
            margin-bottom: 22px;
        }

        .login-title {
            margin: 0;
            font-size: 34px;
            line-height: 1.15;
            font-weight: 700;
            color: #171b25;
        }

        .login-card {
            width: 100%;
            border-radius: 12px;
        }

        .login-form {
            padding: 28px 36px 30px 36px !important;
        }

        .login-field {
            margin-bottom: 24px;
        }

        .login-label {
            display: block;
            margin-bottom: 9px;
            font-size: 16px;
            font-weight: 500;
            color: #171b25;
        }

        .login-password-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 9px;
        }

        .login-forgot {
            white-space: nowrap;
            flex-shrink: 0;
            font-size: 14px;
            color: #ef0018 !important;
            text-decoration: none;
        }

            .login-forgot:hover {
                color: #d90016 !important;
            }

        .login-input {
            height: 49px;
        }

        .login-submit {
            width: 100%;
            height: 49px;
            margin-top: 4px;
            background: #ef0018 !important;
            color: white !important;
            border: none !important;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .login-submit:hover {
                background: #d90016 !important;
            }

        .login-footer {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 28px;
        }

        .login-footer-line {
            flex: 1;
            border-top: 1px solid #d9dee6;
        }

        .login-footer-text {
            flex-shrink: 0;
            white-space: nowrap;
            font-size: 10px;
            font-weight: 500;
            text-transform: uppercase;
            color: #718096;
        }
    </style>

    <div class="flex items-center justify-center grow bg-center bg-no-repeat page-bg px-4">

        <div class="login-container">

            <!-- HEADER -->
            <div class="login-header">
                <h1 class="login-title">
                    Acceso al sistema
                </h1>
            </div>


            <!-- CARD -->
            <div class="kt-card login-card">

                <form asp-controller="Acceso"
                      asp-action="Index"
                      method="POST"
                      id="sign_in_form"
                      class="kt-card-content login-form">

                    <!-- USUARIO -->
                    <div class="login-field">

                        <label class="kt-form-label login-label">
                            Usuario o correo electrónico
                        </label>

                        <div class="kt-input login-input">

                            <i class="ki-filled ki-user text-gray-500 text-lg"></i>

                            <input name="usuario"
                                   type="text"
                                   autocomplete="username"
                                   placeholder="Ingresa tu usuario o correo electrónico" />

                        </div>

                    </div>


                    <!-- CONTRASEÑA -->
                    <div class="login-field">

                        <div class="login-password-header">

                            <label class="kt-form-label login-label"
                                   style="margin-bottom:0;">
                                Contraseña
                            </label>

                            <a href="#"
                               class="login-forgot">
                                ¿Olvidaste tu contraseña?
                            </a>

                        </div>

                        <div class="kt-input login-input"
                             data-kt-toggle-password="true">

                            <i class="ki-filled ki-lock-2 text-gray-500 text-lg"></i>

                            <input name="user_password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" />

                            <button type="button"
                                    class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent!"
                                    data-kt-toggle-password-trigger="true">

                                <span class="kt-toggle-password-active:hidden">
                                    <i class="ki-filled ki-eye text-gray-500"></i>
                                </span>

                                <span class="hidden kt-toggle-password-active:block">
                                    <i class="ki-filled ki-eye-slash text-gray-500"></i>
                                </span>

                            </button>

                        </div>

                    </div>


                    <!-- BOTÓN -->
                    <button type="submit"
                            class="kt-btn login-submit">
                        Iniciar sesión
                    </button>


                    <!-- FOOTER -->
                    <div class="login-footer">

                        <div class="login-footer-line"></div>

                        <span class="login-footer-text">
                            Acceso exclusivo para personal autorizado
                        </span>

                        <div class="login-footer-line"></div>

                    </div>

                </form>

            </div>

        </div>

    </div>
    <!-- End of Page -->
    <!-- Scripts -->
    <script src="js/core.bundle.js">
    </script>
    <script src="vendors/ktui/ktui.min.js">
    </script>
    <script src="vendors/apexcharts/apexcharts.min.js">
    </script>
    <!-- End of Scripts -->
</body>
</html>
