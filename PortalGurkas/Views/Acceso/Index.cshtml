                    <i class="ki-filled ki-shield-tick"></i>
                </div>

                <div class="brand-footer-content">

                    <div class="brand-footer-title">
                        Personas cuidando personas
                    </div>

                    <div class="brand-footer-hashtag">
                        #SeguridadDeOtroNivel
                    </div>

                </div>

            </div>

        </div>

    </main>


