@model PortalGurkas.Models.Acceso.Usuario;
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="h-full"
      data-kt-theme="true"
      data-kt-theme-mode="light"
      dir="ltr"
      lang="es">

<head>
    <base href="../../../../../">

    <title>Portal Gurkas</title>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- FAVICON -->
    <link href="media/app/gurkas-touch-icon.png"
          rel="apple-touch-icon"
          sizes="180x180" />

    <link href="media/app/gurkas_favicon-32x32.png"
          rel="icon"
          sizes="32x32"
          type="image/png" />

    <link href="media/app/gurkas_favicon-16x16.png"
          rel="icon"
          sizes="16x16"
          type="image/png" />

    <link href="media/app/gurkas.ico"
          rel="shortcut icon" />

    <!-- FONT -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- METRONIC -->
    <link href="vendors/apexcharts/apexcharts.css"
          rel="stylesheet" />

    <link href="vendors/keenicons/styles.bundle.css"
          rel="stylesheet" />

    <link href="css/styles.css"
          rel="stylesheet" />

    <style>

        /* =========================================================
               CONFIGURACIÓN GENERAL
            ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-width: 0;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            overflow-y: hidden;
        }


        /* =========================================================
               FONDO GENERAL
            ========================================================= */

        .gurkas-login-page {
            position: relative;
            width: 100%;
            min-width: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 40px 6.5%;
            background-image: url('media/images/fondo_gurkas.png');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            overflow: hidden;
        }


        /* =========================================================
               CONTENEDOR LOGIN
            ========================================================= */

        .login-wrapper {
            position: relative;
            z-index: 5;
            width: 100%;
            max-width: 500px;
            min-width: 0;
        }


        /* =========================================================
               CARD LOGIN
            ========================================================= */

        .gurkas-login-card {
            position: relative;
            z-index: 2;
            width: 100%;
            min-width: 0;
            padding: 48px 42px 42px 42px;
            background: rgba(255, 255, 255, 0.98);
            border: 1px solid rgba(218, 223, 230, 0.9);
            border-radius: 16px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.20), 0 8px 25px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(4px);
        }


        /* =========================================================
               CABECERA LOGIN
            ========================================================= */

        .login-header {
            text-align: center;
            margin-bottom: 38px;
        }

        .login-title {
            margin: 0;
            font-size: 31px;
            line-height: 1.2;
            font-weight: 700;
            letter-spacing: -0.6px;
            color: #111827;
        }

        .login-subtitle {
            margin-top: 10px;
            margin-bottom: 0;
            font-size: 15px;
            font-weight: 400;
            color: #6b7280;
        }


        /* =========================================================
               CAMPOS
            ========================================================= */

        .login-field {
            width: 100%;
            min-width: 0;
            margin-bottom: 24px;
        }

        .login-label {
            display: block;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 600;
            color: #151922;
        }


        /* =========================================================
               HEADER CONTRASEÑA
            ========================================================= */

        .password-header {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 9px;
        }

            .password-header .login-label {
                margin-bottom: 0;
            }


        /* =========================================================
               INPUT
            ========================================================= */

        .gurkas-input {
            width: 100%;
            min-width: 0;
            height: 52px;
            display: flex;
            align-items: center;
            gap: 11px;
            padding-left: 16px;
            padding-right: 10px;
            border: 1px solid #d8dde5;
            border-radius: 7px;
            background: #ffffff;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .gurkas-input:focus-within {
                border-color: #ef0018;
                box-shadow: 0 0 0 3px rgba(239, 0, 24, 0.08);
            }

            .gurkas-input > i {
                flex-shrink: 0;
                font-size: 18px;
                color: #8b96a8;
            }

            .gurkas-input input {
                flex: 1;
                width: auto;
                min-width: 0;
                padding: 0;
                border: none;
                outline: none;
                background: transparent;
                color: #1f2937;
                font-size: 14px;
            }

                .gurkas-input input::placeholder {
                    color: #9ca3af;
                }


        /* =========================================================
               MOSTRAR / OCULTAR CONTRASEÑA
            ========================================================= */

        .password-toggle {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: none;
            outline: none;
            cursor: pointer;
            background: transparent !important;
            border-radius: 6px;
        }

            .password-toggle:hover {
                background: #f5f6f8 !important;
            }

            .password-toggle i {
                color: #919aaa;
                font-size: 18px;
            }


        /* =========================================================
               OLVIDASTE TU CONTRASEÑA
            ========================================================= */

        .login-forgot {
            flex-shrink: 0;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            color: #ef0018 !important;
            transition: .2s ease;
        }

            .login-forgot:hover {
                color: #c80014 !important;
                text-decoration: underline;
            }


        /* =========================================================
               BOTÓN LOGIN
            ========================================================= */

        .login-submit {
            width: 100%;
            height: 54px;
            margin-top: 5px;
            border: none !important;
            outline: none;
            border-radius: 7px;
            background: #ef0018 !important;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 13px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(239, 0, 24, 0.16);
            transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        }

            .login-submit:hover {
                background: #d80016 !important;
                transform: translateY(-1px);
                box-shadow: 0 9px 22px rgba(239, 0, 24, 0.24);
            }

            .login-submit:active {
                transform: translateY(0);
            }

            .login-submit i {
                color: #ffffff;
                font-size: 17px;
            }


        /* =========================================================
               FOOTER DEL CARD
            ========================================================= */

        .login-footer {
            width: 100%;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-top: 31px;
        }

        .login-footer-line {
            height: 1px;
            flex: 1;
            background: #d7dce4;
        }

        .login-footer-text {
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 500;
            color: #7e8797;
            text-transform: uppercase;
            white-space: nowrap;
        }


        /* =========================================================
               MENSAJE CORPORATIVO IZQUIERDO
            ========================================================= */

        .brand-message {
            position: absolute;
            left: 5.8%;
            top: 57%;
            transform: translateY(-50%);
            z-index: 4;
            color: #ffffff;
        }

        .brand-line {
            width: 72px;
            height: 4px;
            margin-bottom: 22px;
            border-radius: 3px;
            background: #ef0018;
            box-shadow: 0 0 12px rgba(239, 0, 24, .20);
        }

        .brand-title-small {
            font-size: 31px;
            line-height: 1.1;
            font-weight: 400;
            letter-spacing: 1px;
            color: #ffffff;
            text-shadow: 0 3px 12px rgba(0, 0, 0, .25);
        }

        .brand-title-main {
            margin-top: 4px;
            font-size: 35px;
            line-height: 1.05;
            font-weight: 700;
            letter-spacing: .3px;
            color: #ffffff;
            text-shadow: 0 3px 14px rgba(0, 0, 0, .30);
        }

        .brand-subtitle {
            margin-top: 23px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 5px;
            color: rgba(255, 255, 255, .72);
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .25);
        }

            .brand-subtitle span {
                margin: 0 7px;
                color: rgba(255, 255, 255, .55);
            }


        /* =========================================================
               MENSAJE CORPORATIVO INFERIOR
               DESKTOP
            ========================================================= */

        .brand-footer-message {
            position: fixed;
            left: 3.4%;
            bottom: 6.2%;
            z-index: 5;
            display: flex;
            align-items: center;
            gap: 17px;
            color: #ffffff;
        }


        /* ESCUDO */

        .brand-footer-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: rgba(255, 255, 255, .78);
        }

            .brand-footer-icon i {
                font-size: 43px;
                color: rgba(255, 255, 255, .78);
            }


        /* CONTENIDO */

        .brand-footer-content {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }


        /* PERSONAS CUIDANDO PERSONAS */

        .brand-footer-title {
            font-size: 14px;
            line-height: 1.2;
            font-weight: 500;
            letter-spacing: 1.7px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .82);
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .30);
        }


        /* HASHTAG */

        .brand-footer-hashtag {
            font-size: 13px;
            line-height: 1.2;
            font-weight: 500;
            letter-spacing: .5px;
            color: #ef0018;
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .35);
        }


        /* =========================================================
               VALORES CORPORATIVOS SUPERIOR DERECHO
            ========================================================= */

        .brand-values {
            position: absolute;
            top: 5.5%;
            right: 5.5%;
            z-index: 5;
            display: flex;
            flex-direction: column;
            gap: 7px;
            text-align: left;
            pointer-events: none;
        }

            .brand-values span {
                display: block;
                font-size: 15px;
                line-height: 1.1;
                font-weight: 400;
                letter-spacing: 3px;
                color: rgba(255, 255, 255, 0.48);
                text-transform: uppercase;
                text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
            }


        /* =========================================================
               RESPONSIVE - LAPTOP
            ========================================================= */

        @@media (max-width: 1400px) {

            .gurkas-login-page {
                padding-right: 5%;
            }

            .login-wrapper {
                max-width: 455px;
            }

            .gurkas-login-card {
                padding: 40px 36px 36px 36px;
            }

            .login-title {
                font-size: 28px;
            }
            /* TEXTO IZQUIERDO */

            .brand-message {
                left: 4.5%;
                top: 58%;
            }

            .brand-title-small {
                font-size: 25px;
            }

            .brand-title-main {
                font-size: 30px;
            }

            .brand-subtitle {
                font-size: 13px;
                letter-spacing: 3px;
            }
            /* MENSAJE INFERIOR */

            .brand-footer-message {
                left: 3%;
                bottom: 4%;
            }

            .brand-footer-title {
                font-size: 12px;
            }

            .brand-footer-hashtag {
                font-size: 11px;
            }

            .brand-footer-icon i {
                font-size: 37px;
            }
            /* VALORES SUPERIORES */

            .brand-values {
                top: 4%;
                right: 4%;
            }

                .brand-values span {
                    font-size: 12px;
                    letter-spacing: 2.5px;
                }
        }


        /* =========================================================
               RESPONSIVE - TABLET
            ========================================================= */

        @@media (max-width: 1050px) {

            body {
                overflow-y: auto;
            }

            .gurkas-login-page {
                position: relative;
                width: 100%;
                min-width: 0;
                min-height: 100vh;
                padding: 30px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-size: cover;
                background-position: 40% center;
                background-repeat: no-repeat;
                overflow: hidden;
            }
                /* CAPA OSCURA */

                .gurkas-login-page::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(4, 17, 32, .42);
                    z-index: 1;
                }
            /* OCULTAMOS TEXTOS GRANDES */

            .brand-message,
            .brand-values {
                display: none !important;
            }
            /* LOGIN */

            .login-wrapper {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 480px;
                min-width: 0;
                margin: 0 auto;
            }

            .gurkas-login-card {
                width: 100%;
                max-width: 100%;
                min-width: 0;
            }
            /* OCULTAMOS EL MENSAJE INFERIOR
                   EN TABLET.
                   LO ACTIVAMOS NUEVAMENTE EN MÓVIL. */

            .brand-footer-message {
                display: none !important;
            }
        }


        /* =========================================================
               RESPONSIVE - MÓVIL
            ========================================================= */

        @@media (max-width: 576px) {

            html,
            body {
                width: 100%;
                min-width: 0;
                min-height: 100%;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            body {
                overflow-y: auto;
            }
            /* =====================================================
                   FONDO
                ===================================================== */

            .gurkas-login-page {
                position: relative;
                width: 100%;
                min-width: 0;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                /*
                       Dejamos espacio inferior para el eslogan.
                    */
                padding: 20px 16px 115px 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-image: url('media/images/fondo_gurkas.png');
                background-size: cover;
                background-position: 43% center;
                background-repeat: no-repeat;
                overflow: hidden;
            }
                /* CAPA OSCURA */

                .gurkas-login-page::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(3, 15, 28, .45);
                    z-index: 1;
                }
            /* =====================================================
                   OCULTAMOS LOS ELEMENTOS GRANDES DE ESCRITORIO
                ===================================================== */

            .brand-message,
            .brand-values {
                display: none !important;
            }
            /* =====================================================
                   LOGIN
                ===================================================== */

            .login-wrapper {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 390px;
                min-width: 0;
                margin: 0 auto;
            }


            .gurkas-login-card {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 100%;
                min-width: 0;
                margin: 0;
                padding: 32px 22px 28px 22px;
                border-radius: 15px;
                background: rgba(255, 255, 255, .98);
                box-shadow: 0 20px 50px rgba(0, 0, 0, .30);
            }
            /* =====================================================
                   CABECERA
                ===================================================== */

            .login-header {
                margin-bottom: 27px;
            }

            .login-title {
                font-size: 24px;
                line-height: 1.2;
            }

            .login-subtitle {
                margin-top: 7px;
                font-size: 12px;
                line-height: 1.4;
            }
            /* =====================================================
                   CAMPOS
                ===================================================== */

            .login-field {
                width: 100%;
                min-width: 0;
                margin-bottom: 20px;
            }

            .login-label {
                font-size: 12px;
            }

            .gurkas-input {
                width: 100%;
                min-width: 0;
                height: 49px;
                padding-left: 13px;
                padding-right: 8px;
                gap: 9px;
            }

                .gurkas-input > i {
                    font-size: 16px;
                }

                .gurkas-input input {
                    flex: 1;
                    width: auto;
                    min-width: 0;
                    font-size: 12px;
                }

                    .gurkas-input input::placeholder {
                        font-size: 12px;
                    }
            /* =====================================================
                   CONTRASEÑA
                ===================================================== */

            .password-header {
                width: 100%;
                gap: 8px;
            }

            .login-forgot {
                flex-shrink: 0;
                font-size: 10px;
                white-space: nowrap;
            }

            .password-toggle {
                width: 32px;
                height: 32px;
            }

                .password-toggle i {
                    font-size: 16px;
                }
            /* =====================================================
                   BOTÓN
                ===================================================== */

            .login-submit {
                width: 100%;
                height: 50px;
                margin-top: 3px;
                font-size: 13px;
            }
            /* =====================================================
                   FOOTER DEL CARD
                ===================================================== */

            .login-footer {
                width: 100%;
                min-width: 0;
                gap: 7px;
                margin-top: 24px;
            }

            .login-footer-line {
                min-width: 15px;
            }

            .login-footer-text {
                flex-shrink: 1;
                font-size: 7px;
                white-space: nowrap;
                text-align: center;
            }
            /* =====================================================
                   PERSONAS CUIDANDO PERSONAS
                   DEBAJO DEL CARD
                ===================================================== */

            .brand-footer-message {
                display: flex !important;
                position: absolute;
                left: 50%;
                bottom: -78px;
                transform: translateX(-50%);
                z-index: 3;
                width: max-content;
                max-width: calc(100vw - 32px);
                align-items: center;
                justify-content: center;
                gap: 12px;
                color: #ffffff;
            }
            /* ESCUDO */

            .brand-footer-icon {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .brand-footer-icon i {
                    font-size: 34px;
                    color: rgba(255, 255, 255, .92);
                }
            /* CONTENIDO */

            .brand-footer-content {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
            /* PERSONAS CUIDANDO PERSONAS */

            .brand-footer-title {
                font-size: 11px;
                line-height: 1.2;
                font-weight: 600;
                letter-spacing: 1.3px;
                text-transform: uppercase;
                white-space: nowrap;
                color: rgba(255, 255, 255, .95);
                text-shadow: 0 2px 8px rgba(0, 0, 0, .40);
            }
            /* HASHTAG */

            .brand-footer-hashtag {
                font-size: 10px;
                line-height: 1.2;
                font-weight: 600;
                letter-spacing: .3px;
                white-space: nowrap;
                color: #ef0018;
                text-shadow: 0 2px 8px rgba(0, 0, 0, .45);
            }
        }


        /* =========================================================
               CELULARES PEQUEÑOS
            ========================================================= */

        @@media (max-width: 380px) {

            .gurkas-login-page {
                padding: 16px 12px 105px 12px;
                background-position: 43% center;
            }

            .login-wrapper {
                max-width: 100%;
            }

            .gurkas-login-card {
                padding: 28px 18px 25px 18px;
            }

            .login-header {
                margin-bottom: 24px;
            }

            .login-title {
                font-size: 22px;
            }

            .login-subtitle {
                font-size: 11px;
            }

            .login-label {
                font-size: 11px;
            }

            .login-forgot {
                font-size: 9px;
            }

            .gurkas-input {
                height: 47px;
            }

                .gurkas-input input {
                    font-size: 11px;
                }

                    .gurkas-input input::placeholder {
                        font-size: 11px;
                    }

            .login-submit {
                height: 48px;
                font-size: 12px;
            }

            .login-footer-text {
                font-size: 6.5px;
            }
            /* MENSAJE INFERIOR */

            .brand-footer-message {
                bottom: -72px;
                gap: 10px;
            }

            .brand-footer-icon {
                width: 34px;
                height: 34px;
            }

                .brand-footer-icon i {
                    font-size: 31px;
                }

            .brand-footer-title {
                font-size: 9.5px;
                letter-spacing: 1px;
            }

            .brand-footer-hashtag {
                font-size: 9px;
            }
        }

    </style>

</head>


<body>

    <!-- =========================================================
         LOGIN
    ========================================================== -->

    <main class="gurkas-login-page">

        <!-- TEXTO CORPORATIVO IZQUIERDO -->
        <div class="brand-message">

            <div class="brand-line"></div>

            <div class="brand-title-small">
                SISTEMA DE
            </div>

            <div class="brand-title-main">
                GESTIÓN EMPRESARIAL
            </div>

            <div class="brand-subtitle">
                INTEGRACIÓN <span>|</span> CONTROL <span>|</span> EFICIENCIA
            </div>

        </div>

        <!-- MENSAJE SUPERIOR DERECHO -->
        <div class="brand-values">
            <span>COMPROMISO</span>
            <span>EXCELENCIA</span>
            <span>CONFIANZA</span>
        </div>


        <div class="login-wrapper">

            <div class="gurkas-login-card">

                <!-- HEADER -->
                <div class="login-header">

                    <h1 class="login-title">
                        Acceso al sistema
                    </h1>

                    <p class="login-subtitle">
                        Ingresa tus credenciales para continuar
                    </p>

                </div>


                <!-- FORMULARIO -->

                <form asp-controller="Acceso"
                      asp-action="Index"
                      method="POST"
                      id="sign_in_form">

                    @Html.AntiForgeryToken()


                    <!-- USUARIO -->

                    <div class="login-field">

                        <label class="login-label">
                            Usuario o correo electrónico
                        </label>

                        <div class="gurkas-input">

                            <i class="ki-filled ki-user"></i>

                            <input name="usuario"
                                   type="text"
                                   autocomplete="username"
                                   placeholder="Ingresa tu usuario o correo electrónico" />

                        </div>

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="login-field">

                        <div class="password-header">

                            <label class="login-label">
                                Contraseña
                            </label>

                            <a href="#"
                               class="login-forgot">

                                ¿Olvidaste tu contraseña?

                            </a>

                        </div>


                        <div class="gurkas-input"
                             data-kt-toggle-password="true">

                            <i class="ki-filled ki-lock-2"></i>


                            <input name="user_password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" />


                            <button type="button"
                                    class="password-toggle"
                                    data-kt-toggle-password-trigger="true">

                                <span class="kt-toggle-password-active:hidden">

